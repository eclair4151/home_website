{
  "schema": 1,
  "providers": [
    {
      "id": "streameast-test",
      "name": "StreamEast",
      "version": 1,
      "enabled": true,
      "domains": {
        "base": "https://streamseast.dad",
        "discover": {
          "url": "https://streamseast.zip/",
          "value": { "sel": "a.sport-card[href]", "attr": "href", "regex": "^(https?://[^/]+)" }
        }
      },
      "http": {
        "fetch": "auto",
        "userAgent": "chrome-desktop",
        "headers": { "Accept-Language": "en-US,en;q=0.9" }
      },
      "start": "sports",
      "pages": {
        "sports": {
          "url": "{base}/",
          "layout": "menu",
          "list": "nav a.nav-link[href]:not([href='/'])",
          "item": {
            "title": "@text",
            "url": "@href"
          },
          "next": "games"
        },
        "games": {
          "layout": "rows",
          "groupBy": "state",
          "refreshSec": 60,
          "require": ["url"],
          "list": ["a.matches[href]", ".matches-main a[href]"],
          "item": {
            "url": "@href",
            "title": ["@aria-label", ".matches-team@text"],
            "subtitle": { "sel": ".team-name", "all": true, "join": " vs " },
            "images": "img.team-logo@src[]",
            "state": [
              { "sel": ".status-badge", "attr": "class", "map": { "bg-success": "live", "bg-danger": "final" } },
              { "sel": ".truncate", "const": "upcoming" },
              { "const": "channel" }
            ],
            "badge": [".status-badge@text", ".truncate@text"],
            "startTime": {
              "sel": ".truncate",
              "attr": "html",
              "regex": "moment\\('([^']+)'\\)",
              "pipe": [{ "date": ["ISO"] }]
            },
            "eventId": { "from": "url", "regex": "(\\d{6,})" }
          },
          "next": [
            { "match": "/redzone$", "page": "game" },
            { "match": "/\\d{6,}/", "page": "game" }
          ]
        },
        "game": {
          "autoPlay": true,
          "fields": {
            "title": ["h1.match-head@text", "title@text"],
            "subtitle": "h2.h-title@text",
            "images": "img.mph-teamlogo@src[]",
            "badge": ".match-score@text"
          },
          "sources": {
            "list": "#mainDiv iframe.embed-responsive-item[src]",
            "item": {
              "url": "@src",
              "label": { "const": "Main" }
            },
            "resolve": ["sniff"]
          }
        }
      },
      "resolvers": {
        "sniff": {
          "type": "webview-sniff",
          "referer": "page",
          "match": ["\\.m3u8(\\?|$)", "\\.mpd(\\?|$)", "\\.mp4(\\?|$)"],
          "ignore": ["/ads?/", "vast", "doubleclick", "googlesyndication"],
          "mutedAutoplay": true,
          "blockPopups": true,
          "timeoutSec": 20
        }
      },
      "player": {
        "live": true,
        "stallSec": 8,
        "bufferingTimeoutSec": 15,
        "maxReresolve": 3,
        "chromecast": true,
        "airplay": true
      },
      "enrich": {
        "provider": "espn",
        "leagues": {
          "NFL": "football/nfl",
          "NBA": "basketball/nba",
          "NHL": "hockey/nhl",
          "MLB": "baseball/mlb"
        }
      },
      "ui": {
        "title": "What do you want to watch?",
        "subtitle": "Pick a sport",
        "loading": "Loading sports…",
        "empty": "No sports on right now",
        "error": "Couldn't reach the site. Pull to retry.",
        "categoryLoading": "Loading {name}…",
        "categoryEmptyTitle": "Nothing on right now",
        "categoryEmptyDetail": "No games found for {name}.",
        "categoryError": "Couldn't load {name}"
      }
    },
    {
      "id": "streameasto",
      "name": "StreamEast",
      "version": 1,
      "enabled": true,
      "domains": { "base": "https://streameasto.cx" },
      "http": {
        "fetch": "http",
        "userAgent": "chrome-desktop",
        "headers": { "Accept-Language": "en-US,en;q=0.9" }
      },
      "start": "sports",
      "pages": {
        "sports": {
          "url": "{base}/",
          "layout": "menu",
          "list": "nav a.nav-link[href]",
          "item": { "title": "@text", "url": "@href" },
          "next": "games"
        },
        "games": {
          "layout": "rows",
          "groupBy": "state",
          "refreshSec": 60,
          "require": ["url", "title"],
          "list": "a.card-link[href]",
          "item": {
            "url": { "attr": "href", "replace": ["streameasto.cx", "streamseaste.cx"] },
            "title": ".card-title@text",
            "category": ".card-cat@text",
            "state": { "sel": ".card-live-pill", "window": ["data-starts", "data-ends"] },
            "startTime": { "sel": ".card-live-pill", "attr": "data-starts", "pipe": [{ "date": ["epoch"] }] },
            "endTime": { "sel": ".card-live-pill", "attr": "data-ends", "pipe": [{ "date": ["epoch"] }] }
          }
        }
      },
      "player": { "live": true, "stallSec": 8, "bufferingTimeoutSec": 15, "chromecast": false, "airplay": true },
      "enrich": {
        "provider": "espn",
        "leagues": {
          "NFL": "football/nfl",
          "NBA": "basketball/nba",
          "WNBA": "basketball/wnba",
          "MLB": "baseball/mlb",
          "NHL": "hockey/nhl",
          "CFB": "football/college-football",
          "NCAAB": "basketball/mens-college-basketball",
          "CFL": "football/cfl"
        }
      }
    },
    {
      "id": "streameast-cool",
      "name": "StreamEast",
      "version": 1,
      "enabled": true,
      "domains": {
        "base": "https://streameast.cool"
      },
      "http": {
        "fetch": "http",
        "userAgent": "chrome-desktop",
        "headers": {
          "Accept-Language": "en-US,en;q=0.9"
        }
      },
      "start": "sports",
      "pages": {
        "sports": {
          "url": "{base}/",
          "sections": [
            {
              "title": "Sports",
              "list": [
                "#primaryNav a.nav-mainlink[href*=streams]",
                "a.nav-mainlink[href*=streams]"
              ],
              "require": [
                "title",
                "url"
              ],
              "item": {
                "title": [
                  ".link-text@text",
                  "@text"
                ],
                "url": "@href"
              }
            },
            {
              "title": "More",
              "list": "footer.site-footer a[href*=streams]",
              "require": [
                "title",
                "url"
              ],
              "item": {
                "title": {
                  "attr": "text",
                  "replace": {
                    "from": "\\s*Streams$",
                    "to": "",
                    "regex": true
                  }
                },
                "url": "@href"
              }
            },
            {
              "title": "Everything",
              "list": "#primaryNav .logo a[href]",
              "require": [
                "title",
                "url"
              ],
              "item": {
                "title": {
                  "const": "All Games"
                },
                "url": "@href"
              }
            }
          ]
        },
        "games": {
          "list": [
            "li.match-card",
            "#GelecekMaclar li[data-league]",
            "a.f1-podium--link[href]"
          ],
          "require": [
            "url"
          ],
          "item": {
            "url": [
              "a.f1-podium--link@href",
              "a[href]@href",
              "@href"
            ],
            "title": ".MacBaslik@text",
            "category": ".f1-podium--rank@text",
            "state": [
              {
                "sel": ".btn-live",
                "const": "live"
              },
              {
                "sel": ".SaatZamanBilgisi",
                "const": "upcoming"
              }
            ],
            "badge": {
              "sel": ".SaatZamanBilgisi:not(.btn-live)",
              "attr": "text"
            },
            "espnPath": {
              "attr": "data-league",
              "map": {
                "-nba$": "basketball/nba",
                "-wnba$": "basketball/wnba",
                "-ncaab$": "basketball/mens-college-basketball",
                "-nfl$": "football/nfl",
                "-cfb$": "football/college-football",
                "-nhl$": "hockey/nhl",
                "-mlb$": "baseball/mlb",
                "-premier-league$": "soccer/eng.1",
                "-laliga$": "soccer/esp.1",
                "-serie-a$": "soccer/ita.1",
                "-mls$": "soccer/usa.1"
              }
            }
          }
        },
        "game": {
          "fields": {
            "title": [
              "h1@text",
              "title@text"
            ],
            "images": ".msb-team img@src[]",
            "badge": ".msb-status@text"
          },
          "sources": {
            "list": [
              "#Alternatifler [onclick*=changeStream]",
              "iframe#wp_player[src]"
            ],
            "item": {
              "url": [
                {
                  "attr": "onclick",
                  "regex": "changeStream\\((\\d+)\\)",
                  "pipe": [
                    {
                      "prepend": "https://gooz.aapmains.net/new-stream-embed/"
                    }
                  ]
                },
                "@src"
              ],
              "label": [
                "@text",
                {
                  "const": "Main"
                }
              ]
            }
          }
        }
      },
      "enrich": {
        "provider": "espn",
        "leagues": {
          "NBA": "basketball/nba",
          "WNBA": "basketball/wnba",
          "NCAAB": "basketball/mens-college-basketball",
          "NFL": "football/nfl",
          "CFB": "football/college-football",
          "NHL": "hockey/nhl",
          "MLB": "baseball/mlb"
        }
      },
      "ui": {
        "title": "What do you want to watch?",
        "subtitle": "Pick a sport",
        "loading": "Loading sports…",
        "empty": "No sports on right now",
        "error": "Couldn't reach the site. Pull to retry.",
        "categoryLoading": "Loading {name}…",
        "categoryEmptyTitle": "Nothing on right now",
        "categoryEmptyDetail": "No games found for {name}.",
        "categoryError": "Couldn't load {name}"
      }
    }
  ]
}
